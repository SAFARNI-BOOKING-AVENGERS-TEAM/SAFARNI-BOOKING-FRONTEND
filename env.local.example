# Backend API URL (your Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# JWT Secret (must match your backend ACCESS_TOKEN_SECRET)
# Used in middleware.ts to verify tokens server-side
JWT_SECRET=your_jwt_secret_here

# Cloudinary (for Next.js Image optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
